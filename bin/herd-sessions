#!/usr/bin/env bash
# herd-sessions — list Kiro CLI sessions with ID, directory, age, and title
# Helps you find session IDs to pin for restore.
#
# By default, shows only sessions touched in the last 14 days (recent work is
# what you almost always want). Widen or lift the window when hunting an old one.
#
# Usage:
#   herd-sessions              # last 14 days, newest first
#   herd-sessions <filter>     # filter by title/dir substring (case-insensitive)
#   herd-sessions --days 30    # widen the window to 30 days
#   herd-sessions --all        # no window — every session
#   herd-sessions --days 60 pricing   # window + filter compose

set -euo pipefail

SESSIONS_DIR="$HOME/.kiro/sessions/cli"

# --- Parse args: flags in any order, plus one optional positional filter ---
window_days=14
filter=""
while [ $# -gt 0 ]; do
  case "$1" in
    --all|-a)   window_days=0; shift;;
    --days|-d)  window_days="${2:?--days needs a number}"; shift 2;;
    -h|--help)  sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0;;
    -*)         echo "Unknown option: $1" >&2; exit 1;;
    *)          filter="$1"; shift;;
  esac
done

if ! [[ "$window_days" =~ ^[0-9]+$ ]]; then
  echo "Error: --days needs a non-negative integer" >&2; exit 1
fi

if [ ! -d "$SESSIONS_DIR" ]; then
  echo "No sessions directory at $SESSIONS_DIR"
  exit 1
fi

# Collect: mtime<TAB>session_id<TAB>cwd<TAB>title, sort by mtime desc
{
  for f in "$SESSIONS_DIR"/*.json; do
    [ -f "$f" ] || continue
    id=$(jq -r '.session_id // empty' "$f" 2>/dev/null) || continue
    [ -n "$id" ] || continue
    cwd=$(jq -r '.cwd // "?"' "$f" 2>/dev/null)
    title=$(jq -r '.title // "untitled"' "$f" 2>/dev/null)
    # mtime for sorting (macOS stat)
    mtime=$(stat -f '%m' "$f" 2>/dev/null || echo 0)
    printf '%s\t%s\t%s\t%s\n' "$mtime" "$id" "$cwd" "$title"
  done
} | sort -rn | {
  now=$(date +%s)
  cutoff=0
  [ "$window_days" -gt 0 ] && cutoff=$(( now - window_days * 86400 ))
  hidden=0
  while IFS=$'\t' read -r mtime id cwd title; do
    # Age window: skip sessions older than the cutoff (0 = no window)
    if [ "$cutoff" -gt 0 ] && [ "$mtime" -lt "$cutoff" ]; then
      hidden=$(( hidden + 1 ))
      continue
    fi
    # Apply filter if given
    if [ -n "$filter" ]; then
      shopt -s nocasematch
      if [[ "$title" != *"$filter"* && "$cwd" != *"$filter"* ]]; then
        continue
      fi
      shopt -u nocasematch
    fi
    # Human-readable age
    age=$(( (now - mtime) / 3600 ))
    if [ "$age" -lt 1 ]; then age_str="<1h"; elif [ "$age" -lt 24 ]; then age_str="${age}h"; else age_str="$(( age / 24 ))d"; fi
    # Truncate title
    short_title="${title:0:60}"
    printf '%-6s  %s  %-28s  %s\n' "$age_str" "$id" "$(basename "$cwd")" "$short_title"
  done
  if [ "$hidden" -gt 0 ]; then
    printf '\n… %d older session(s) hidden (>%dd). Use --days N or --all to see them.\n' "$hidden" "$window_days" >&2
  fi
}
