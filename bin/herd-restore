#!/usr/bin/env bash
# herd-restore — rebuild Herdr workspaces and resume pinned Kiro sessions
#
# Run this after a restart to bring back your pinned sessions.
# Reads the pin manifest from the herd.restore plugin state dir
# (populated by herd-pin / herd-pin-current). The startup plugin hook
# invokes the same core automatically after a Herdr restart.
#
# Usage:
#   herd-restore            # rebuild all pinned sessions
#   herd-restore --dry-run  # show what it would do, no changes
#
# ── Architecture note (T13/L) ─────────────────────────────────────────────
# The manifest-read + per-session rebuild logic is factored into a callable
# core (`herd_restore_rebuild_all` / `herd_restore_one`) so a future Herdr
# `[[startup]]` plugin can source this file and call the core directly instead
# of shelling out to the whole script. The manual-trigger wrapper below
# (arg parsing + the `main` call) is deliberately thin — the plugin becomes
# its trigger, so we invest in the core, not the wrapper ergonomics.
#
# ── Resume mechanics (T10 gate finding, verified live 2026-09-11) ─────────
# Herdr's canonical executable for `--kind kiro` is BARE `kiro-cli`. Kiro's
# resume flags live on the `chat` SUBCOMMAND, and bare `kiro-cli` SILENTLY
# DROPS `--resume-id` and starts a FRESH session (the long-standing "restored
# as a blank chat" bug). The passthrough after `--` must therefore be
# `chat --resume-id <id>`, NOT `--resume-id <id>`.
#   WRONG: herdr agent start … -- --resume-id <id>       # starts fresh
#   RIGHT: herdr agent start … -- chat --resume-id <id>  # resumes

set -euo pipefail

# ── Manifest location (T13/WS-4) ──────────────────────────────────────────
# The pin manifest now lives in the herd.restore plugin's state dir so the
# Herdr [[startup]] hook (which gets HERDR_PLUGIN_STATE_DIR) and the pin
# scripts (plain shells, which do NOT) agree on one path. The state dir is a
# deterministic XDG path derived from the plugin id, so a plain shell can
# compute it without the hook-only env var:
#   ${XDG_STATE_HOME:-~/.local/state}/herdr/plugins/herd.restore/restore.tsv
# Precedence: explicit HERD_RESTORE_MANIFEST override → plugin state dir →
# legacy ~/.config/herd/restore.tsv (only if it still exists and the new one
# does not, easing the one-time migration).
_herd_state_manifest() {
  local base="${XDG_STATE_HOME:-$HOME/.local/state}"
  printf '%s\n' "$base/herdr/plugins/herd.restore/restore.tsv"
}
if [ -n "${HERD_RESTORE_MANIFEST:-}" ]; then
  MANIFEST="$HERD_RESTORE_MANIFEST"
else
  MANIFEST="$(_herd_state_manifest)"
  # Legacy fallback: read the old path if it exists and the new one doesn't.
  legacy="$HOME/.config/herd/restore.tsv"
  if [ ! -s "$MANIFEST" ] && [ -s "$legacy" ]; then
    MANIFEST="$legacy"
  fi
fi
SESSIONS_DIR="${KIRO_SESSIONS_DIR:-$HOME/.kiro/sessions/cli}"

# ── Single-process lock helpers ───────────────────────────────────────────
# Kiro writes <session_id>.lock = {"pid":N,"started_at":"..."} next to each
# session file while it is open. Resuming a session whose lock PID is still a
# live kiro-cli process collides with Kiro's single-process-per-session lock
# and fails. We detect that and skip, rather than start a doomed/fresh pane.

# Echo "alive" if the given session currently has a live-process lock, else "".
session_is_active() {
  local id="$1" lock pid comm
  lock="$SESSIONS_DIR/$id.lock"
  [ -f "$lock" ] || { echo ""; return 0; }
  pid=$(jq -r '.pid // empty' "$lock" 2>/dev/null || echo "")
  [ -n "$pid" ] || { echo ""; return 0; }
  # Is that PID alive AND a kiro process? (a recycled PID for something else
  # should not count as an active Kiro session)
  comm=$(ps -p "$pid" -o comm= 2>/dev/null || echo "")
  if [ -n "$comm" ] && printf '%s' "$comm" | grep -qi 'kiro'; then
    echo "alive"
  else
    echo ""
  fi
}

# ── Reconciliation guard (T13/WS-4 follow-up) ─────────────────────────────
# After a Herdr server restart, Herdr's SNAPSHOT RESTORE re-runs each pane's
# saved command line verbatim. A pane that was launched with
# `… -- chat --resume-id <id>` is therefore brought back ALREADY RESUMING that
# session — WITHOUT any Herdr "integration" (Kiro's integration role is `none`;
# see .kiro/research/2026-09-15-herdr-native-restore-vs-herd-restore.md). If
# herd-restore then rebuilds the same pinned id, you get DUPLICATE workspaces
# (observed 2026-09-15). The lock check (session_is_active) catches this once
# Kiro has written its <id>.lock, but Kiro writes that lock a beat AFTER launch,
# so a restore that runs inside that window races past it. This argv scan is the
# EARLIER, race-free signal: a live kiro-cli process whose command line already
# names the pinned id means Herdr's snapshot replay already brought it back.
#
# NOTE we match the bare UUID anywhere in argv, NOT an anchored `--resume-id`:
# a resumed pane's own process/wrapper can carry the id without the flag (its
# TUI also rewrites its terminal_title away from the launch command), so the
# `--resume-id`-anchored form misses drifted panes. The lock check is the
# authoritative fallback for panes whose argv shows no id at all.
_UUID_RE='[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'

# Echo every session id currently named in a live kiro-cli process's argv,
# one per line, de-duplicated. Empty if none. Scanned once per restore run.
live_session_ids_from_argv() {
  ps -Ao pid,command 2>/dev/null \
    | grep -i '[k]iro-cli' \
    | grep -oE "$_UUID_RE" \
    | sort -u
}

# True (0) if $1 is a session already live under Herdr. Three signals, skip if
# ANY holds:
#   (0) it IS the restore context's own session ($KIRO_SESSION_ID) — you can
#       never need to rebuild the session you are running FROM, and doing so
#       is the exact race that produced a bare shell for the launching pane
#       (2026-09-15: hq-ws4 was the live HQ chat herd-restore ran from; the
#       rebuild collided with Herdr's replay of that same pane). This signal
#       is race-free and needs no argv/lock timing to have settled. It is only
#       populated for the MANUAL path — the [[startup]] hook fires in Herdr's
#       process with no KIRO_SESSION_ID, where direction (1)/(2) cover it.
#   (1) its id appears in the pre-scanned live-argv set ($2, newline-delimited).
#   (2) it holds a live single-process lock (session_is_active).
session_already_live() {
  local id="$1" argv_ids="${2:-}"
  if [ -n "${KIRO_SESSION_ID:-}" ] && [ "$id" = "$KIRO_SESSION_ID" ]; then
    return 0
  fi
  if [ -n "$argv_ids" ] && printf '%s\n' "$argv_ids" | grep -qxF "$id"; then
    return 0
  fi
  [ "$(session_is_active "$id")" = "alive" ]
}

# ── Bounded wait-and-recheck (T13/WS-4 race fix, direction 2) ──────────────
# The race: after `server stop` + relaunch there is a window where Herdr's
# snapshot restore has NOT YET re-run a pinned pane's `chat --resume-id <id>`
# (so no argv match) AND Kiro has NOT YET written `<id>.lock` (so no lock
# match). A guard that checks inside that gap sees "not live" and rebuilds;
# milliseconds later Herdr's replay relocks the session and the rebuild's own
# `agent start` collides with the single-process lock → timeout → bare shell.
#
# This helper gives Herdr's async replay a bounded chance to settle before we
# commit to rebuilding. It RE-SCANS the live signals each iteration (the argv
# set passed into herd_restore_one was scanned once up-front and is stale for
# this purpose), returning as soon as the session shows up live — or after the
# budget expires. It is a no-op cost on the common path: the FIRST check runs
# before any sleep, so a session that is genuinely absent still returns fast
# on iteration 0; only a session that is present-but-not-yet-visible pays the
# poll, which is exactly the case we must not lose to a rebuild.
#
# Budget is intentionally small (a few hundred ms total) — long enough to
# cover Herdr's replay + Kiro's lock-write latency, short enough not to stall
# a restore of many genuinely-absent sessions. Tunable via env:
#   HERD_RESTORE_SETTLE_TRIES  (default 6)   number of checks (incl. the first)
#   HERD_RESTORE_SETTLE_SLEEP  (default 0.25) seconds between checks
#
# Returns 0 (skip — it settled live) or 1 (still not live after the budget).
session_settles_live() {
  local id="$1"
  local tries="${HERD_RESTORE_SETTLE_TRIES:-6}"
  local nap="${HERD_RESTORE_SETTLE_SLEEP:-0.25}"
  local i fresh_argv
  for (( i = 0; i < tries; i++ )); do
    # Own-session + lock are cheap; re-scan argv fresh (do NOT reuse the stale
    # pre-scanned set) so a just-replayed pane is seen the moment it appears.
    fresh_argv="$(live_session_ids_from_argv)"
    if session_already_live "$id" "$fresh_argv"; then
      return 0
    fi
    # Sleep BETWEEN checks only, never after the last — keeps the genuinely
    # -absent path from paying the full budget's tail.
    if [ "$(( i + 1 ))" -lt "$tries" ]; then
      sleep "$nap"
    fi
  done
  return 1
}

# ══════════════════════════════════════════════════════════════════════════
# Resume-into-bare-shells reconciliation (WS-4 redesign)
# Spec: .kiro/specs/ws4-resume-into-bare-shells-SPEC.md
#
# Real-restart evidence (2026-09-15) disproved the timing-based guard above for
# the [[startup]] hook path: the hook fires ~11s BEFORE Herdr's snapshot replay
# brings a pinned Kiro pane back, so racing an async event with a fixed sleep is
# unsafe. This path instead REACTS to final pane state: wait until pane state
# SETTLES, then fill ONLY panes Herdr restored as bare shells (no Kiro agent),
# resuming the pinned session INTO the existing pane rather than creating a
# duplicate workspace. Detection uses the structured `herdr pane list` `agent`
# field (agent=="kiro" ⇒ live; absent ⇒ bare shell) — race-free once queried.
# ══════════════════════════════════════════════════════════════════════════

# Emit a normalised, comparable snapshot of all panes: one line per pane,
# TAB-separated `pane_id<TAB>agent<TAB>cwd`, sorted for stable comparison.
# `agent` is "kiro" for a live Kiro pane or "" (empty) for a bare shell. This
# is the single source of truth for both settle-detection and bare-shell
# matching, so both observe identical data.
panes_snapshot() {
  herdr pane list 2>/dev/null | jq -r '
    .result.panes[]
    | [.pane_id, (.agent // ""), .cwd] | @tsv
  ' 2>/dev/null | sort
}

# True (0) if EVERY resumable pin in the manifest is ACCOUNTED-FOR in the given
# snapshot ($1): there is a pane (live Kiro OR bare shell) at the pin's cwd. A
# pin whose session file is missing is not resumable, so it does not hold up the
# wait (it will be skipped by reconcile). This is the settle signal that matters
# — "Herdr has brought back a pane for everything I need to restore" — rather
# than "pane state stopped changing", which looks true in the GAPS of a slow,
# staggered replay (restart #2: this pane replayed ~27s after the hook, long
# after a 3-read stability window would have fired).
all_pins_accounted_for() {
  local snapshot="$1" name id cwd
  while IFS=$'\t' read -r name id cwd; do
    [ -n "$name" ] || continue
    # Not resumable → does not block the wait.
    [ -f "$SESSIONS_DIR/$id.json" ] || continue
    # Accounted-for iff some pane (any agent, incl. bare shell) sits at this cwd.
    if ! printf '%s\n' "$snapshot" | awk -F'\t' -v c="$cwd" '$3==c{f=1} END{exit !f}'; then
      return 1
    fi
  done < "$MANIFEST"
  return 0
}

# Poll panes_snapshot until every resumable pin is ACCOUNTED-FOR (a pane exists
# at its cwd), OR a hard ceiling elapses. Echoes the final snapshot.
#
# We deliberately do NOT stop on "pane state went quiet": during a slow,
# staggered replay the snapshot looks stable in the GAPS between pane arrivals,
# and stopping there stranded a pin whose pane had not replayed yet (restart #2:
# this pane replayed ~27s after the hook). Accounted-for is the goal state; the
# only other exit is the ceiling, after which any still-missing pin falls
# through to the fresh-workspace path. A manifest pin Herdr will never restore
# therefore costs one ceiling wait — acceptable and rare, and the safe default.
#
# Tunable via env:
#   HERD_RESTORE_SETTLE_POLL_SEC    (default 1)   seconds between reads
#   HERD_RESTORE_SETTLE_CEILING_SEC (default 60)  hard cap on total wait
wait_for_pane_settle() {
  local poll="${HERD_RESTORE_SETTLE_POLL_SEC:-1}"
  local ceiling="${HERD_RESTORE_SETTLE_CEILING_SEC:-60}"
  local cur waited=0
  cur="$(panes_snapshot)"
  while :; do
    # Primary (and only early) stop: everything we need has a pane.
    if all_pins_accounted_for "$cur"; then
      break
    fi
    # Hard ceiling: give up waiting; unaccounted pins take the fallback path.
    if awk "BEGIN{exit !($waited >= $ceiling)}"; then
      break
    fi
    sleep "$poll"
    waited="$(awk "BEGIN{print $waited + $poll}")"
    cur="$(panes_snapshot)"
  done
  printf '%s\n' "$cur"
}

# Given a settled snapshot ($1, multiline pane_id<TAB>agent<TAB>cwd) and a cwd
# ($2), echo the pane_id IFF exactly one BARE-SHELL pane (agent field empty)
# matches that cwd. Echo "" for zero matches or genuine ambiguity (≥2). We do
# NOT guess on ambiguity — filling the wrong session into a pane is worse than
# leaving a bare shell for the human.
bare_shell_pane_for_cwd() {
  local snapshot="$1" want_cwd="$2" matches
  matches="$(printf '%s\n' "$snapshot" | awk -F'\t' -v c="$want_cwd" '
    $2 == "" && $3 == c { print $1 }
  ')"
  # Count matches; only a unique hit is actionable.
  if [ "$(printf '%s\n' "$matches" | grep -c .)" = "1" ]; then
    printf '%s\n' "$matches"
  else
    printf '\n'
  fi
}

# Echo "kiro" if the settled snapshot has a LIVE Kiro pane at $2 (cwd), else "".
# Used to skip pins Herdr already brought back fully.
live_kiro_pane_for_cwd() {
  local snapshot="$1" want_cwd="$2"
  printf '%s\n' "$snapshot" | awk -F'\t' -v c="$want_cwd" '
    $2 == "kiro" && $3 == c { print "kiro"; exit }
  '
}

# Resume a pinned session INTO an existing bare-shell pane (validated mechanic:
# herdr agent start --pane <existing> resumes in place, no new workspace).
# Args: name, session-id, pane-id. Honors DRY_RUN. Returns non-zero on failure.
resume_into_pane() {
  local name="$1" id="$2" pane_id="$3"
  if [ "${DRY_RUN:-false}" = "true" ]; then
    echo "  [dry-run] herdr agent start $name --kind kiro --pane $pane_id -- chat --resume-id $id"
    return 0
  fi
  if herdr agent start "$name" --kind kiro --pane "$pane_id" -- chat --resume-id "$id" >/dev/null 2>&1; then
    echo "  ✓ resumed session $id INTO existing pane $pane_id (no duplicate workspace)"
    return 0
  fi
  echo "  ✗ failed to resume '$name' into pane $pane_id." >&2
  return 1
}

# Among all pins that share a cwd, decide whether pin $1(id) is the OWNER of
# that cwd $2. Used to break the shared-cwd ambiguity (restart #2: a dead
# `hq-ws4` pin and the live `hq-ws4-racefix` both sat at ai-instructions, and
# blanket "leave both" stranded the REAL session). Ownership rule, in order:
#   1. If exactly one pin at the cwd is LIVE (own $KIRO_SESSION_ID, live lock),
#      that pin owns it; every other pin at the cwd is SUPERSEDED.
#   2. Else the pin with the newest session-file mtime owns it (most recently
#      active wins); ties fall to the first in manifest order.
# Echoes the owning session id for cwd $2 (empty if no resumable pin there).
owner_id_for_cwd() {
  local want_cwd="$1" name id cwd best_id="" best_mtime=-1 live_id="" live_count=0 m
  while IFS=$'\t' read -r name id cwd; do
    [ -n "$name" ] || continue
    [ "$cwd" = "$want_cwd" ] || continue
    [ -f "$SESSIONS_DIR/$id.json" ] || continue
    # Liveness: own session, or a held lock.
    if [ "$id" = "${KIRO_SESSION_ID:-}" ] || [ "$(session_is_active "$id")" = "alive" ]; then
      live_id="$id"; live_count=$(( live_count + 1 ))
    fi
    m="$(stat -f '%m' "$SESSIONS_DIR/$id.json" 2>/dev/null || stat -c '%Y' "$SESSIONS_DIR/$id.json" 2>/dev/null || echo 0)"
    if [ "$m" -gt "$best_mtime" ]; then best_mtime="$m"; best_id="$id"; fi
  done < "$MANIFEST"
  # Exactly one live pin → it owns. Otherwise newest mtime owns.
  if [ "$live_count" = "1" ]; then
    printf '%s\n' "$live_id"
  else
    printf '%s\n' "$best_id"
  fi
}

# Reconcile pinned sessions against SETTLED pane state. For each pin:
#   • live Kiro pane already at its cwd            → skip (idempotent)
#   • NOT the owner of a shared cwd (superseded)   → skip (stale duplicate)
#   • exactly one bare-shell pane at its cwd       → resume INTO that pane
#   • no pane at its cwd at all                    → fresh workspace (fallback)
# This is the entry the [[startup]] hook and the manual wrapper both call.
# Returns non-zero if any pin failed to reconcile.
reconcile_bare_shells() {
  local failures=0 name id cwd snapshot pane
  echo "⧗ Waiting for Herdr pane state to settle before reconciling…"
  snapshot="$(wait_for_pane_settle)"

  # Which cwds are shared by ≥2 pins? Only those need ownership resolution.
  local shared_cwds
  shared_cwds="$(awk -F'\t' '{print $3}' "$MANIFEST" | sort | uniq -d)"

  while IFS=$'\t' read -r name id cwd; do
    [ -n "$name" ] || continue
    echo "→ Reconciling '$name'  (session $id)"
    echo "  cwd: $cwd"

    if [ ! -f "$SESSIONS_DIR/$id.json" ]; then
      echo "  ✗ skip — no session file for $id; would start FRESH, not resume." >&2
      failures=$(( failures + 1 )); continue
    fi

    # Shared-cwd resolution (fix a): if ≥2 pins share this cwd, only the OWNER
    # (live pin, else newest) is reconciled; the rest are superseded duplicates
    # and skipped. This stops a stale pin from stranding the real session.
    if printf '%s\n' "$shared_cwds" | grep -qxF "$cwd"; then
      local owner
      owner="$(owner_id_for_cwd "$cwd")"
      if [ "$id" != "$owner" ]; then
        echo "  ⏭ skip — superseded: another pin owns $cwd (owner session $owner)."
        continue
      fi
    fi

    if [ -n "$(live_kiro_pane_for_cwd "$snapshot" "$cwd")" ]; then
      echo "  ⏭ skip — a live Kiro pane already serves $cwd (Herdr restored it)."
      continue
    fi

    pane="$(bare_shell_pane_for_cwd "$snapshot" "$cwd")"
    pane="$(printf '%s' "$pane" | tr -d '[:space:]')"
    if [ -n "$pane" ]; then
      resume_into_pane "$name" "$id" "$pane" || failures=$(( failures + 1 ))
    else
      # No bare-shell pane at this cwd (and no live one). Herdr restored no pane
      # here — fall back to creating a fresh workspace (existing behaviour).
      echo "  · no restored pane at $cwd — creating a fresh workspace."
      herd_restore_one "$name" "$id" "$cwd" || failures=$(( failures + 1 ))
    fi
  done < "$MANIFEST"
  return $(( failures > 0 ? 1 : 0 ))
}

# ── Post-start verification (SOFT signal) ─────────────────────────────────
# The DETERMINISTIC checks are the pre-flight guards in herd_restore_one:
#   (a) the session file <id>.json must exist to be resumable, and
#   (b) session_is_active must be false (no live lock).
# This post-start read is only a soft confirmation — pane content is polluted
# by TUI chrome, one-off upgrade/interstitial prompts, and (on resume) arbitrary
# restored conversation text, so it CANNOT be trusted as the sole verdict.
# It returns 0 (quiet) unless it sees Kiro's explicit no-session string, in
# which case it warns. It never fails a restore on content-absence alone.
verify_resumed() {
  local pane="$1" id="$2" out
  sleep 2
  out=$(herdr pane read "$pane" --source recent-unwrapped --lines 80 2>/dev/null || echo "")
  if printf '%s' "$out" | grep -qiE 'no saved chat sessions|no conversation to resume|could ?n.?t find .* session'; then
    echo "    ⚠ '$id' — Kiro printed a no-session message; it may have started fresh." >&2
    return 1
  fi
  return 0
}

# ── Rebuild core (sharable with a future [[startup]] plugin) ──────────────

# Rebuild a single pinned session. Args: name, session-id, cwd.
# Honors DRY_RUN. Emits progress; returns non-zero on a detected failure.
herd_restore_one() {
  local name="$1" id="$2" cwd="$3"
  local rc=0

  echo "→ Restoring '$name'  (session $id)"
  echo "  cwd: $cwd"

  # Guard: the session must actually exist to be resumable. A missing
  # <id>.json means a bogus/deleted id — resuming it silently starts a FRESH
  # chat (Kiro does not always print a no-session message). This deterministic
  # check is the reliable catch; pane-content scraping is not.
  if [ ! -f "$SESSIONS_DIR/$id.json" ]; then
    echo "  ✗ skip — no session file for $id in $SESSIONS_DIR." >&2
    echo "    That id would start a FRESH chat, not resume. Re-pin from inside the pane" >&2
    echo "    with herd-pin-current, or check 'herd-sessions' for the correct id." >&2
    return 1
  fi

  # Reconciliation guard: is this session ALREADY live under Herdr? After a
  # server restart Herdr's snapshot replay may have already brought the pane
  # back resuming this id (argv signal) — or a live lock is held — or this IS
  # the session we are running from ($KIRO_SESSION_ID). Rebuilding any of those
  # duplicates the workspace or races Herdr's replay into a bare shell, so skip.
  #
  # We use the bounded settle-and-recheck (session_settles_live) rather than a
  # single check: after `server stop`+relaunch a pinned pane can be briefly
  # invisible to BOTH the argv and lock signals while Herdr's async replay is
  # in flight. A single check inside that window sees "not live" and rebuilds,
  # colliding with the replay's relock (2026-09-15: bare shell for hq-ws4). The
  # settle poll re-scans the live signals for a small budget so the replay can
  # surface first. The very first check runs before any sleep, so a genuinely
  # absent session still falls through to rebuild promptly.
  if session_settles_live "$id"; then
    echo "  ⏭ skip — session $id is already live (Herdr already restored this pane)."
    echo "    Rebuilding would duplicate the workspace or race its restore; leaving it."
    return 0
  fi

  # Guard: warn (don't fail) if the cwd no longer exists.
  if [ ! -d "$cwd" ]; then
    echo "  ⚠ cwd does not exist: $cwd — creating workspace anyway, resume may fail." >&2
  fi

  if [ "${DRY_RUN:-false}" = "true" ]; then
    echo "  [dry-run] herdr workspace create --cwd $cwd --label $name --no-focus"
    echo "  [dry-run] herdr agent start $name --kind kiro --pane <pane> -- chat --resume-id $id"
    return 0
  fi

  local created pane_id
  created=$(herdr workspace create --cwd "$cwd" --label "$name" --no-focus)
  pane_id=$(printf '%s' "$created" | jq -r '.result.root_pane.pane_id')
  if [ -z "$pane_id" ] || [ "$pane_id" = "null" ]; then
    echo "  ✗ failed to create workspace/pane for '$name'." >&2
    return 1
  fi

  # Start Kiro in that pane, resuming the exact session by ID.
  # NOTE the `chat` subcommand before --resume-id (see header). Args after --
  # are passed straight to the kiro-cli executable.
  if herdr agent start "$name" --kind kiro --pane "$pane_id" -- chat --resume-id "$id" >/dev/null 2>&1; then
    if verify_resumed "$pane_id" "$id"; then
      echo "  ✓ resumed session $id"
    else
      echo "  ⚠ started, but could NOT confirm resume (see reason above)." >&2
      rc=1
    fi
  else
    echo "  ✗ agent start failed/timed out for '$name' (pane $pane_id)." >&2
    echo "    Read the pane with: herdr pane read $pane_id --source recent-unwrapped" >&2
    rc=1
  fi
  echo ""
  return $rc
}

# Read the manifest and rebuild every pinned session. Returns non-zero if any
# session failed to confirm resume.
herd_restore_rebuild_all() {
  local failures=0 name id cwd
  # The reconciliation guard now re-scans the live-argv set fresh inside the
  # bounded settle poll (session_settles_live) so it can catch a pane that
  # Herdr's async replay surfaces mid-restore. A single up-front scan would be
  # a stale snapshot for that purpose, so it is gone — the poll owns the scan.
  while IFS=$'\t' read -r name id cwd; do
    [ -n "$name" ] || continue
    herd_restore_one "$name" "$id" "$cwd" || failures=$(( failures + 1 ))
  done < "$MANIFEST"
  return $(( failures > 0 ? 1 : 0 ))
}

# ── Manual-trigger wrapper (thin; the plugin replaces this) ───────────────
main() {
  DRY_RUN=false
  [ "${1:-}" = "--dry-run" ] && DRY_RUN=true
  export DRY_RUN

  command -v jq >/dev/null || { echo "jq required"; exit 1; }

  if [ ! -s "$MANIFEST" ]; then
    echo "No pinned sessions in $MANIFEST"
    echo "Pin some first: herd-pin-current <name>   (exact, from inside the pane)"
    echo "            or: herd-pin <name> <session-id>"
    exit 1
  fi

  # Ensure the Herdr server is reachable (a workspace command spawns it if not).
  if ! herdr ping >/dev/null 2>&1; then
    echo "Herdr server not responding; the first workspace command will start it."
  fi

  if reconcile_bare_shells; then
    echo "Done. Run 'herdr' and check the sidebar."
  else
    echo "Done WITH WARNINGS — one or more pins could not be reconciled (missing" >&2
    echo "session file, or an ambiguous cwd shared by ≥2 pins). Re-check the flagged" >&2
    echo "lines above and resume those manually. Run 'herdr' to inspect." >&2
    exit 2
  fi
}

# Only run main when executed directly, not when sourced by a plugin.
# (BASH_SOURCE[0] == $0 means "executed", not "sourced".)
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
  main "$@"
fi
